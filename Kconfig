menu "espure Configuration"

    menu "Locale Selection"
        comment "Select locales to include in build"
        comment "Each locale adds memory to the binary"

        config ESPURE_LOCALE_DE_DE
            bool "German Dictionary (de-DE)"
            default y
            help
                Include the German (Germany) locale dictionary and phoneme rules.
                Size: ~764 KB (compressed) or ~1.5 MB (binary array)

        config ESPURE_LOCALE_EN_GB
            bool "British English Architecture Pilot (en-GB)"
            default n
            help
                Include a small English pronunciation pilot. This is not full
                English support and does not provide English fallback rules.

    endmenu

    choice
        prompt "Dictionary Storage Mode"
        default ESPURE_DICT_BINARY_ARRAY
        help
            Select how the dictionary is stored in flash and memory.
            
            - Binary Array: Very fast binary search, but requires ~1.5MB for German. Best if PSRAM is available.
            - Huffman Trie: Highly compressed, parses on-the-fly. Minimal RAM, saves Flash space. Best for ESP32 Classic.

        config ESPURE_DICT_BINARY_ARRAY
            bool "Flat Binary Array (Fastest)"

        config ESPURE_DICT_HUFFMAN_TRIE
            bool "Compressed Huffman Trie (Low Memory)"
    endchoice

endmenu
