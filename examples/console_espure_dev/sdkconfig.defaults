CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_ECC_ENABLE=n

CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

CONFIG_ESPURE_LOCALE_DE_DE=y
CONFIG_ESPURE_LOCALE_EN_GB=y
CONFIG_ESPURE_DICT_HUFFMAN_TRIE=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

CONFIG_UART_FILEBRIDGE_NUM=1
CONFIG_UART_FILEBRIDGE_TX_PIN=30
CONFIG_UART_FILEBRIDGE_RX_PIN=31
CONFIG_UART_FILEBRIDGE_RTS_PIN=50
CONFIG_UART_FILEBRIDGE_CTS_PIN=29
CONFIG_UART_FILEBRIDGE_BAUD=3000000
CONFIG_UART_FILEBRIDGE_SD_MOUNT_OWN=y
CONFIG_UART_FILEBRIDGE_BACKEND_LITTLEFS=n
CONFIG_UART_FILEBRIDGE_BACKEND_SPIFFS=n
CONFIG_UART_FILEBRIDGE_BACKEND_FLASH_FAT=n
